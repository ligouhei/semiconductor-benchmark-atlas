  "protocols": [
    {
      "id": "be-evodrc-skill-evolution",
      "benchmark_family": "EvoDRC method on DAC26 DRC",
      "name": "EvoDRC / layer-skill evolution for block-level DRC repair",
      "category": "后端/DRC修复与技能演化agent",
      "artifact_type": "复用既有DAC26七block的方法协议；非新独立数据集",
      "task_layer": "layout crop→几何patch→DRC/连通反馈→技能记忆",
      "version": "arXiv2607.20019v1；repo69a138b /benchmarkgitlink72610ed",
      "input": "DAC26七block的ASAP7 GDS/KLayoutPython layout、初始DRVreport、gold连通文件与DRM图；初始244/68/89/147/68/247/765，共1628DRV。额外CLA37DRV由人工修复用于生成初始skill，非第八heldout测试题。",
      "task": "把版图分为≤2×2µm crop，按层skills调用ReAct修复agent；连接preview/DRCpreview/impactpreview辅助几何操作。逐leaf先连通硬门，再拼装全block DRC/连通；经DBsummary生成Markov/stateless两skilldraft并judge至多选一，模型权重固定。",
      "output": "修复版图script与DRVs、各层经验/skill、patch及校验记录。current最终输出是最近连通未broken的assembly，不是全历史最小DRV；局部改进可导致全局退步。",
      "metrics": "paper最多5outeriterations、零DRV早停，repairagent无walltime上限；一次iteration可许多crop/modelcalls。Table5 pooled净减少(1628−432)/1628=73.464%，不是73.5%设计clean或相对另一强工具的提升；逐block平均83.623%，clean2/7。最终109/8/0/22/0/18/275；须另报新增DRV。",
      "baseline": "同Sonnet4.6medium三消融：无CLA经验、固定skills、wholeblock不分crop。wholeblock消融也clean2/7且在Block1/4/6更好，但pooled49.08%；不是全面优于所有任务。缺等budget原生几何/商业autoDRCfix对照，不据此称替代工业router。",
      "tools_and_access": "KLayout0.30.1/ASAP7真实deck；agent源BSD3header、无rootLICENSE单文件，上游PDK/benchmark许可另列。132blobs/完整tree/releases核；未执行KLayout/模型。paper费用$1152.23为作者API定价折算，86.4%在repair，不含完整CPU/人工CLA种子/工具成本。",
      "limitations": "连通是合并metal/via层上pin DFS，作者明确不是LVS，不证明逻辑/寄生/时序/功耗签核。Block1迭代DRV145→233显示非单调；controller所谓best注释实际last-good且emit判断!=broken，缺状态不可当已证通过。当前data占位、无全量历史DB；代码能力与已发布轨迹分开。",
      "industrial_value": "研究判断：有工程价值的DRC工具编排/可验证记忆演化研究，底层几何checker继续作原生工具；七题规模/无硬wallbudget和不完整历史发布仍限制模型横向比较。",
      "primary_sources": "https://arxiv.org/html/2607.20019v1; https://github.com/ASU-VDA-Lab/EvoDRC/tree/69a138b081b007772a39e643342d520ca656ce4f",
      "evidence_status": "第二轮12h进行中；一手正文/固定Git源码和数据静态核查，EvoDRC132/OSAT47 Gitblobs和1890行结果核查；未执行模型、EDA、仿真、形式工具或第三方代码。",
      "next_verification": "需冻结逐trial的输入、agent版本、原始反馈/成功硬门/失败分母/成本与许可；论文成绩与当前配置不一致处需原始运行记录，不默改作者成绩。",
      "retrieved_date": "2026-10-20"

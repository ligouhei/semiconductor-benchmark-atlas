  "programs": [
    {
      "name": "DFADD",
      "input_task": "SoftFloat双精度加法，以64bit整数编码浮点数",
      "functional_gate": "46固定输入对，结果位模式与gold不等则累加；不按任意浮点容差判分"
    },
    {
      "name": "DFMUL",
      "input_task": "SoftFloat双精度乘法",
      "functional_gate": "20固定输入对，位模式精确比较"
    },
    {
      "name": "DFDIV",
      "input_task": "SoftFloat双精度除法",
      "functional_gate": "22固定输入对，位模式精确比较"
    },
    {
      "name": "DFSIN",
      "input_task": "以SoftFloat实现双精度sin",
      "functional_gate": "36固定弧度样本，结果位模式精确比较；不是任意native-libm/fastmath误差合同"
    },
    {
      "name": "MIPS",
      "input_task": "简化MIPS执行固定排序指令流",
      "functional_gate": "最终指令数必须611，另比较8个dmem单元；不是全ISA/异常/并发验证"
    },
    {
      "name": "ADPCM",
      "input_task": "固定音频数组编码/解码",
      "functional_gate": "比较compressed与decoded result各自gold数组，累加不匹配"
    },
    {
      "name": "GSM",
      "input_task": "GSM线性预测编码分析",
      "functional_gate": "160 sample输出与另组参数gold比较，固定输入不是完整语音场景集"
    },
    {
      "name": "JPEG",
      "input_task": "固定JPEG解压缩/转图像",
      "functional_gate": "比较RGB输出与gold、尺寸等，检查在jpeg2bmp辅助函数内累加全局main_result"
    },
    {
      "name": "MOTION",
      "input_task": "MPEG2运动向量解码固定bitstream",
      "functional_gate": "PMV与motion_vertical_field_select等结构和gold逐项比较，main在mpeg2.c"
    },
    {
      "name": "AES",
      "input_task": "固定输入加密/解密",
      "functional_gate": "aes_enc/aes_dec分别16byte结果与gold比较并累加main_result"
    },
    {
      "name": "BLOWFISH",
      "input_task": "固定Blowfish加密输入流",
      "functional_gate": "blowfish_main返回固定输出检查计数，再由main返回"
    },
    {
      "name": "SHA",
      "input_task": "固定输入的SHA hash",
      "functional_gate": "driver汇总digest等比较；有限向量不证明密码学安全或任意输入等价"
    }
  ],
